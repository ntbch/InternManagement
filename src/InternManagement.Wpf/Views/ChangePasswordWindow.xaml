<Window x:Class="InternManagement.Wpf.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mật khẩu" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Mật khẩu hiện tại" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="txtOld" />
        <TextBlock Text="Mật khẩu mới (tối thiểu 6 ký tự)" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="txtNew" />
        <TextBlock Text="Nhập lại mật khẩu mới" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="txtConfirm" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Lưu" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
            <Button Content="Hủy" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
