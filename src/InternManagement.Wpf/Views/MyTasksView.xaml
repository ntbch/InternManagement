<UserControl x:Class="InternManagement.Wpf.Views.MyTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:InternManagement.Core.Models;assembly=InternManagement.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="160" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Thực tập của tôi" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,6">
                            <TextBlock Text="Mã TTS:" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock x:Name="lblCode" FontWeight="Bold" FontSize="14" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Họ và tên:" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock x:Name="lblName" FontSize="14" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,6">
                            <TextBlock Text="Phòng ban:" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock x:Name="lblDepartment" FontSize="14" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Mentor hướng dẫn:" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock x:Name="lblMentor" FontSize="14" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                            <TextBlock Text="Thời gian thực tập:" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock x:Name="lblPeriod" FontSize="14" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,0">
                            <TextBlock Text="Trạng thái:" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock x:Name="lblStatus" FontSize="14" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,10,0,8" Background="{StaticResource BorderBrush}" />
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="Tiến độ công việc:" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                        <TextBlock x:Name="lblProgressText" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Margin="10,0,0,0" />
                        <ProgressBar x:Name="pbProgress" Height="16" Minimum="0" Value="0" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="Công việc được giao" FontWeight="SemiBold" FontSize="15"
                           Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnStart" Content="Bắt đầu làm" Click="Start_Click" />
                    <Button x:Name="btnComplete" Content="Hoàn thành" Style="{StaticResource PrimaryButton}"
                            Click="Complete_Click" Margin="0" />
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Bottom" Text="* Dòng màu đỏ: công việc quá hạn"
                       Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" FontStyle="Italic" />

            <DataGrid x:Name="gridTasks" SelectionChanged="GridTasks_SelectionChanged">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                <Setter Property="Background" Value="{StaticResource OverdueRowBrush}" />
                                <Setter Property="ToolTip" Value="Quá hạn" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TaskItemStatus.Done}">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="200" />
                    <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="Ngày giao" Binding="{Binding AssignedDate, StringFormat=dd/MM/yyyy}" Width="110" />
                    <DataGridTextColumn Header="Hạn hoàn thành" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="120" />
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status, Converter={StaticResource EnumText}}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="Kết quả đánh giá" FontWeight="SemiBold" FontSize="15"
                       Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,0,6" />

            <DataGrid x:Name="gridEvaluations">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ngày" Binding="{Binding EvaluationDate, StringFormat=dd/MM/yyyy}" Width="110" />
                    <DataGridTextColumn Header="Mentor" Binding="{Binding Mentor.FullName}" Width="160" />
                    <DataGridTextColumn Header="Thái độ" Binding="{Binding AttitudeScore}" Width="80" />
                    <DataGridTextColumn Header="Kỹ năng" Binding="{Binding SkillScore}" Width="80" />
                    <DataGridTextColumn Header="Làm việc nhóm" Binding="{Binding TeamworkScore}" Width="110" />
                    <DataGridTextColumn Header="Điểm TB" Binding="{Binding Average}" Width="80" />
                    <DataGridTextColumn Header="Xếp loại" Binding="{Binding Rank}" Width="90" />
                    <DataGridTextColumn Header="Nhận xét" Binding="{Binding Comment}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
