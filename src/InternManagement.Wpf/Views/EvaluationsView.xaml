<UserControl x:Class="InternManagement.Wpf.Views.EvaluationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Đánh giá thực tập sinh" Style="{StaticResource PageTitle}" />

        <!-- Ghi chú cho tài khoản không phải mentor (Admin chỉ được xem) -->
        <TextBlock x:Name="txtAdminNote" DockPanel.Dock="Top"
                   Text="Chỉ mentor hướng dẫn mới được tạo/sửa đánh giá"
                   Foreground="{StaticResource MutedBrush}"
                   FontStyle="Italic"
                   Margin="0,0,0,10"
                   Visibility="Collapsed" />

        <!-- Thanh thao tác cho Mentor (Thêm, Sửa, Xóa) -->
        <StackPanel x:Name="actionBar" DockPanel.Dock="Top" Style="{StaticResource ActionBar}">
            <Button Content="Thêm" Style="{StaticResource PrimaryButton}" Click="Add_Click" />
            <Button x:Name="btnEdit" Content="Sửa" Click="Edit_Click" />
            <Button x:Name="btnDelete" Content="Xóa" Style="{StaticResource DangerButton}" Click="Delete_Click" />
        </StackPanel>

        <!-- Bảng danh sách phiếu đánh giá -->
        <DataGrid x:Name="grid" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick">
            <!-- DataTrigger trên DataGridRow: tô màu chữ theo xếp loại (Giỏi: xanh lá, Yếu: đỏ) -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rank}" Value="Giỏi">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Rank}" Value="Yếu">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ngày" Binding="{Binding EvaluationDate, StringFormat=dd/MM/yyyy}" Width="100" />
                <DataGridTextColumn Header="Thực tập sinh" Binding="{Binding Intern.FullName}" Width="160" />
                <DataGridTextColumn Header="Mentor" Binding="{Binding Mentor.FullName}" Width="160" />
                <DataGridTextColumn Header="Thái độ" Binding="{Binding AttitudeScore, StringFormat={}{0:0.0}}" Width="80" />
                <DataGridTextColumn Header="Kỹ năng" Binding="{Binding SkillScore, StringFormat={}{0:0.0}}" Width="80" />
                <DataGridTextColumn Header="Làm việc nhóm" Binding="{Binding TeamworkScore, StringFormat={}{0:0.0}}" Width="110" />
                <DataGridTextColumn Header="Điểm TB" Binding="{Binding Average, StringFormat={}{0:0.00}}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Xếp loại" Binding="{Binding Rank}" Width="100" />
                <DataGridTextColumn Header="Nhận xét" Binding="{Binding Comment}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
