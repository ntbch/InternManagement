<Window x:Class="InternManagement.Wpf.Views.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Công việc" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <!-- DataContext là đối tượng TaskItem; các ô nhập dữ liệu Binding hai chiều với các thuộc tính -->
    <StackPanel Margin="20">
        <TextBlock Text="Thực tập sinh *" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="cboIntern" SelectedValuePath="Id"
                  SelectedValue="{Binding InternId, UpdateSourceTrigger=PropertyChanged}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding Code}" /><Run Text=" - "/><Run Text="{Binding FullName}" />
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Tiêu đề *" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="txtTitle" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Mô tả" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Ngày giao" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding AssignedDate}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Hạn hoàn thành *" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding DueDate}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Trạng thái" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="cboStatus" SelectedItem="{Binding Status}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumText}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Lưu" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
            <Button Content="Hủy" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
