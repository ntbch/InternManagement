<Window x:Class="InternManagement.Wpf.Views.InternEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thực tập sinh" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <!-- Form nhập liệu 2 cột sử dụng Grid -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Thông tin cá nhân -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Mã thực tập sinh *" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="txtCode" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Họ tên *" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="txtFullName" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Email *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Điện thoại" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Trường đào tạo" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding University, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Chuyên ngành" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Major, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Cột phải: Thông tin thực tập và phân công -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Ngày bắt đầu *" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding StartDate}" />

                <TextBlock Text="Ngày kết thúc *" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding EndDate}" />

                <TextBlock Text="Trạng thái" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="cboStatus" SelectedItem="{Binding Status}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumText}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Phòng ban *" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="cboDepartment" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding DepartmentId}" SelectionChanged="Department_SelectionChanged" />

                <TextBlock Text="Mentor hướng dẫn" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="cboMentor" DisplayMemberPath="FullName" SelectedValuePath="Id" />
            </StackPanel>
        </Grid>

        <!-- Ghi chú tài khoản chỉ hiển thị khi thêm mới thực tập sinh -->
        <TextBlock x:Name="txtAccountNote" Text="Tài khoản đăng nhập: mã TTS, mật khẩu mặc định 123456"
                   Foreground="{StaticResource MutedBrush}" FontStyle="Italic" Margin="0,16,0,0" />

        <!-- Thanh nút điều khiển Lưu và Hủy -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Lưu" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
            <Button Content="Hủy" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
